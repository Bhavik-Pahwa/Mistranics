# =============================================================================
# Mistranics Environment Configuration
# =============================================================================

# IoT & Telemetry Pipeline
IOT_ENABLED=true
MQTT_ENABLED=true
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_CLIENT_ID=indux-backend
IOT_TOPIC=indux/device-01/telemetry
IOT_SOURCE=physical
IOT_PHYSICAL_DEVICE=device-01
IOT_SIMULATION_DEVICE=simulation-01

# Anomaly Detection Settings
ANOMALY_Z_THRESHOLD=3.0
ANOMALY_BASELINE_SIZE=20
ANOMALY_MIN_BASELINE_SAMPLES=5
ANOMALY_STD_FLOOR=0.1
TELEMETRY_STALE_AFTER_SECONDS=10

# Database Configuration (Optional, for --profile db)
DATABASE_URL=postgresql+psycopg://mistranics:mistranics@localhost:5432/mistranics

