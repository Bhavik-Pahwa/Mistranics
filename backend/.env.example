DATABASE_URL=postgresql+psycopg://mistranics:mistranics@localhost:5432/mistranics
POSTGRES_PASSWORD=replace-with-url-safe-secret
INTERNAL_TOKEN=replace-with-internal-secret
OPERATOR_TOKEN=replace-with-operator-secret
API_TOKEN=replace-with-read-secret
REGISTRY_FILE=examples/registry.json
# POLICY_FILE=examples/demo-policy.json
MQTT_ENABLED=true
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_TOPIC=mistranics/+/telemetry
MQTT_CLIENT_ID=mistranics-backend
MQTT_QOS=1
# MQTT_USERNAME=
# MQTT_PASSWORD=
MQTT_TLS=false
# MQTT_CA=
# MQTT_CERT=
# MQTT_KEY=
MQTT_RECONNECT_MAX=30
MAX_QUERY_DAYS=31
CONTEXT_SECONDS=120
RETRY_SECONDS=5
