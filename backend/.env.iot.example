IOT_ENABLED=true
MQTT_ENABLED=true
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_CLIENT_ID=indux-backend
IOT_TOPIC=indux/device-01/telemetry
IOT_SOURCE=physical
IOT_PHYSICAL_DEVICE=device-01
IOT_SIMULATION_DEVICE=simulation-01
ANOMALY_Z_THRESHOLD=3.0
ANOMALY_BASELINE_SIZE=20
ANOMALY_MIN_BASELINE_SAMPLES=5
ANOMALY_STD_FLOOR=0.1
TELEMETRY_STALE_AFTER_SECONDS=10
# Optional Industrial-only real RAG. Requires AI/requirements.txt and local Ollama.
AI_ENABLED=false
AI_PROVIDER_URL=http://localhost:11434
AI_LLM_MODEL=llama3.2:1b
AI_EMBEDDING_MODEL=nomic-embed-text
AI_PROVIDER_TIMEOUT=180
AI_CONTEXT_TOKENS=8192
AI_MAX_OUTPUT_TOKENS=1024
# Optional existing MQTT_USERNAME, MQTT_PASSWORD and MQTT_TLS settings also apply.
