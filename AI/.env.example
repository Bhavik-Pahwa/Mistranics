# Run from repository root; copy to AI/.env and export before launch (see README).
DATABASE_URL=postgresql+psycopg://mistranics:mistranics@localhost:5432/mistranics
REGISTRY_FILE=backend/examples/registry.json
INTERNAL_TOKEN=replace-with-internal-secret
OPERATOR_TOKEN=replace-with-operator-secret
API_TOKEN=replace-with-read-secret
MQTT_ENABLED=true
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_TOPIC=mistranics/+/telemetry
MQTT_CLIENT_ID=mistranics-backend
MQTT_QOS=1
MQTT_TLS=false
ML_ENABLED=true
# Supply reviewed manufacturer configuration and an explicitly selected trusted model.
# ML_LIMITS_FILE=/absolute/path/to/approved-limits.json
# ML_MODEL_FILE=/absolute/path/to/approved-model.joblib
ML_INCIDENT_POLICY_FILE=ML/examples/incident-policy.json
AI_ENABLED=true
AI_PROVIDER_URL=http://localhost:11434
# AI_PROVIDER_TOKEN=
# Use models supported by your Ollama-compatible server.
AI_LLM_MODEL=
AI_EMBEDDING_MODEL=
AI_PROVIDER_TIMEOUT=60
AI_STALE_SECONDS=15
AI_OCR_ENABLED=false
AI_OCR_LANGUAGE=eng
AI_MAX_PDF_PAGES=100
AI_MAX_CHUNKS=1000
# Legacy POLICY_FILE must be unset or have alerts_enabled=false with ML_ENABLED.
